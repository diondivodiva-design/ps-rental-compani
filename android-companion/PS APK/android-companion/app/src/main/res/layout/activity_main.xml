<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PS RENTAL COMPANION"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="// Operator Console Pairing"
            android:textColor="@color/primary"
            android:textSize="14sp"
            android:letterSpacing="0.2"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_offline"
            android:textColor="@color/muted"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.15"
            android:background="@color/card"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:layout_marginTop="20dp"/>

        <EditText
            android:id="@+id/inpServer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_server"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:background="@color/card"
            android:padding="18dp"
            android:textSize="16sp"
            android:inputType="textUri"
            android:layout_marginTop="28dp"
            android:maxLines="1"/>

        <EditText
            android:id="@+id/inpStation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_station"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:background="@color/card"
            android:padding="18dp"
            android:textSize="16sp"
            android:inputType="text"
            android:layout_marginTop="14dp"
            android:maxLines="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_save"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/primary"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:paddingVertical="18dp"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@string/btn_stop"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/rose"
                android:layout_marginStart="12dp"
                android:letterSpacing="0.1"
                android:paddingVertical="18dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:background="@color/card"
            android:padding="14dp"
            android:layout_marginTop="20dp"
            android:minHeight="200dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tip: Station ID bisa disalin dari dashboard admin → Companion TV."
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:layout_marginTop="18dp"/>
    </LinearLayout>
</ScrollView>
